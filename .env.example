# ---------------------------------------------------------------------------
# PathPilot AI — environment variables
#
# Copy this file to `.env.local` and fill in the values you need.
# The app runs fully on local seed data without any key. AI features are
# optional and gracefully fall back when keys are missing.
# ---------------------------------------------------------------------------

# Groq API key — server-side only. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional model override (defaults to llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant
